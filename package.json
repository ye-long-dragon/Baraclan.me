{
  "name": "baraclan.me",
  "version": "1.0.0",
  "description": "Portfolio Website for Vince Lawrence V. Baraclan",
  "main": "server/dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"blue,green\" \"npm run client\" \"npm run server\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "lint": "npm --prefix client run lint",
    "hash": "tsx server/src/utils/hashPassword.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ye-long-dragon/Baraclan.me.git"
  },
  "author": "Vince Lawrence V. Baraclan",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ye-long-dragon/Baraclan.me/issues"
  },
  "homepage": "https://github.com/ye-long-dragon/Baraclan.me#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.19.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
